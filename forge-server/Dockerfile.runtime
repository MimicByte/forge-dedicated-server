FROM eclipse-temurin:17-jre-jammy

RUN groupadd --gid 10001 forge && useradd --uid 10001 --gid forge --create-home forge \
    && mkdir -p /config /opt/forge && chown forge:forge /config

# The workflow supplies the already-tested distribution as its build context.
COPY forge-server-bin/ /opt/forge/

# The server supports networked Forge games, but does not need desktop campaign
# assets or presentation files. Keep localization and card/gameplay data, plus
# the bundled precon catalogs used by server-managed AI opponents.
RUN mv /opt/forge/res/quest/commanderprecons /tmp/commanderprecons \
    && mv /opt/forge/res/quest/precons /tmp/precons \
    && rm -rf \
    /opt/forge/res/adventure \
    /opt/forge/res/conquest \
    /opt/forge/res/quest \
    /opt/forge/res/puzzle \
    /opt/forge/res/tutorial \
    /opt/forge/res/skins \
    /opt/forge/res/music \
    /opt/forge/res/sound \
    /opt/forge/res/defaults/gauntlet \
    && mkdir -p /opt/forge/res/quest \
    && mv /tmp/commanderprecons /opt/forge/res/quest/commanderprecons \
    && mv /tmp/precons /opt/forge/res/quest/precons

USER 10001:10001
WORKDIR /opt/forge
ENV FORGE_SERVER_PORT=36743 FORGE_SERVER_MODE=COMMANDER FORGE_SERVER_VARIANTS= FORGE_SERVER_MAX_PLAYERS=4 \
    FORGE_SERVER_GAMES_PER_MATCH=3 FORGE_SERVER_COMMANDER_BRACKET=5 FORGE_SERVER_ENFORCE_DECK_LEGALITY=true \
    FORGE_SERVER_ADMIN_PORT=8080 FORGE_SERVER_ALLOWED_PLAYERS= FORGE_SERVER_LOGIN_FAILURE_LIMIT=5 \
    FORGE_SERVER_LOGIN_FAILURE_WINDOW_SECONDS=60 FORGE_SERVER_LOGIN_BLOCK_SECONDS=900 \
    FORGE_SERVER_AFK_TIMEOUT=5 \
    FORGE_SERVER_CRASH_REPORT_MAX_FILES=10 FORGE_SERVER_HEAP_DUMPS=false
EXPOSE 36743/tcp 8080/tcp
VOLUME ["/config"]
HEALTHCHECK --interval=10s --timeout=5s --start-period=300s --retries=3 CMD ["/opt/forge/bin/forge-server", "health"]
ENTRYPOINT ["/opt/forge/bin/forge-server"]
